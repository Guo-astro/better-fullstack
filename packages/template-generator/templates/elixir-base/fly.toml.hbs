app = "{{elixirDeployAppName}}"
primary_region = "iad"

[build]
  dockerfile = "Dockerfile"

[env]
{{#if (ne elixirWebFramework "none")}}
  PHX_HOST = "{{elixirDeployAppName}}.fly.dev"
  PORT = "4000"
{{/if}}
{{#if (eq elixirClustering "libcluster")}}
  DNS_CLUSTER_QUERY = "{{elixirDeployAppName}}.internal"
{{/if}}
{{#if (eq elixirOrm "ecto_sqlite3")}}
  DATABASE_PATH = "/data/{{elixirAppName}}.db"

[mounts]
  source = "{{elixirDeployAppName}}_data"
  destination = "/data"
{{/if}}

{{#if (ne elixirWebFramework "none")}}
[http_service]
  internal_port = 4000
  force_https = true
  auto_stop_machines = true
  auto_start_machines = true
{{#if (eq elixirJobs "oban")}}
  # Oban runs inside the app, so a stopped machine also stops queued and scheduled jobs.
  min_machines_running = 1
{{else}}
  min_machines_running = 0
{{/if}}
  processes = ["app"]
{{/if}}

[[vm]]
  memory = "1gb"
  cpu_kind = "shared"
  cpus = 1
