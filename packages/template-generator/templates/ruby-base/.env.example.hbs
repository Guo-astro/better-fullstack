HOST=127.0.0.1
PORT={{rubyPort}}
ALLOWED_ORIGIN={{rubyWebOrigin}}
RACK_ENV=development
{{#if (or (ne rubyOrm "none") (eq rubyAuth "rodauth"))}}
DATABASE_PATH=db/development.sqlite3
{{/if}}
{{#if (eq rubyAuth "jwt")}}
JWT_SECRET=
JWT_ISSUER=better-fullstack
JWT_AUDIENCE=better-fullstack-api
{{/if}}
{{#if (or (eq rubyAuth "rodauth") (eq rubyAuth "omniauth"))}}
SESSION_SECRET=
{{/if}}
{{#if (eq rubyAuth "omniauth")}}
OIDC_ISSUER=https://issuer.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:{{rubyPort}}/auth/oidc/callback
{{/if}}
{{#if (eq rubyWebFramework "rails")}}
SECRET_KEY_BASE=
{{/if}}
