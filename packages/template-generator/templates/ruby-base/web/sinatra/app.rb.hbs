require "json"
require "sinatra/base"
require_relative "http_policy"
{{#if (ne rubyOrm "none")}}
require_relative "items"
{{/if}}
require_relative "name_input"
require_relative "request_body_limit"

module BetterFullstack
  class App < Sinatra::Base
    use RequestBodyLimit, -> { HttpPolicy.allowed_origins }
    use HttpPolicy
    set :show_exceptions, false
    set :raise_errors, false
    set :dump_errors, false
    set :host_authorization, { permitted_hosts: HttpPolicy::PERMITTED_HOSTS }
    set :protection, except: [:http_origin]

    helpers do
      def json_response(status_code, value)
        status status_code
        content_type :json
        JSON.generate(value)
      end
    end

    before do
      content_type :json
    end

    get "/health" do
      json_response(200, status: "ok", service: "sinatra")
    end

    post "/api/greetings" do
      name = NameInput.parse(request.media_type, request.body)
      halt json_response(name.status, error: name.error) if name.is_a?(NameInput::Invalid)
      json_response(200, greeting: "Hello, #{name}!")
    end
{{#if (ne rubyOrm "none")}}

    get "/api/items" do
      json_response(200, items: Items.all)
    end

    post "/api/items" do
      name = NameInput.parse(request.media_type, request.body)
      halt json_response(name.status, error: name.error) if name.is_a?(NameInput::Invalid)
      json_response(201, Items.create(name))
    end
{{/if}}

    not_found do
      json_response(404, error: "not_found")
    end

    error do
      json_response(500, error: "internal_server_error")
    end
  end
end
