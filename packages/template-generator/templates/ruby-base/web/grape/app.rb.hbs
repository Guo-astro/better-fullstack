require "grape"
require "json"
require_relative "http_policy"
require_relative "name_input"
require_relative "request_body_limit"

module BetterFullstack
  class Api < Grape::API
    format :json
    content_type :json, "application/json"
    default_format :json
    parser :json, nil

    rescue_from :all do
      error!({ error: "internal_server_error" }, 500)
    end

    get "/health" do
      { status: "ok", service: "grape" }
    end

    post "/api/greetings" do
      name = NameInput.parse(request.media_type, env["rack.input"])
      error!({ error: name.error }, name.status) if name.is_a?(NameInput::Invalid)
      status 200
      { greeting: "Hello, #{name}!" }
    end

    route :any, "*path" do
      error!({ error: "not_found" }, 404)
    end
  end

  App = Rack::Builder.app do
    use RequestBodyLimit, -> { HttpPolicy.allowed_origins }
    use HttpPolicy
    run Api
  end
end
