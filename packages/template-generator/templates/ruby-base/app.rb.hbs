require "json"
require "sinatra/base"

module BetterFullstack
  class App < Sinatra::Base
    set :show_exceptions, false
    set :raise_errors, false
    set :dump_errors, false
    set :server, :puma
    set :host_authorization, { permitted_hosts: ["localhost", "127.0.0.1", "::1"] }
    set :allowed_origin, ENV.fetch("ALLOWED_ORIGIN", "{{rubyWebOrigin}}")

    helpers do
      def json_response(status_code, value)
        status status_code
        content_type :json
        JSON.generate(value)
      end
    end

    before do
      content_type :json
      origin = request.env["HTTP_ORIGIN"]
      if origin
        halt 403, JSON.generate(error: "origin_not_allowed") unless origin == settings.allowed_origin
        headers "Access-Control-Allow-Origin" => origin, "Vary" => "Origin"
      end
    end

    options "*" do
      headers "Access-Control-Allow-Methods" => "GET, POST, OPTIONS",
              "Access-Control-Allow-Headers" => "Content-Type"
      status 204
      body ""
    end

    get "/health" do
      json_response(200, status: "ok", service: "sinatra")
    end

    post "/api/greetings" do
      unless request.media_type == "application/json"
        halt 415, JSON.generate(error: "content_type_must_be_json")
      end
      raw = request.body.read(16_385)
      halt 413, JSON.generate(error: "body_too_large") if raw.bytesize > 16_384
      begin
        payload = JSON.parse(raw)
      rescue JSON::ParserError
        halt 400, JSON.generate(error: "invalid_json")
      end
      unless payload.is_a?(Hash) && payload.keys == ["name"] && payload["name"].is_a?(String)
        halt 422, JSON.generate(error: "name_must_be_a_string")
      end
      name = payload["name"].strip
      unless (1..80).cover?(name.length)
        halt 422, JSON.generate(error: "name_length_must_be_1_to_80")
      end
      json_response(200, greeting: "Hello, #{name}!")
    end

    not_found do
      json_response(404, error: "not_found")
    end

    error do
      json_response(500, error: "internal_server_error")
    end
  end
end
