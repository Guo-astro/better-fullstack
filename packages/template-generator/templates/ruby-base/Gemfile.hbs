{{/if}}
{{#if (eq rubyWebFramework "roda")}}
gem "roda", "3.109.0"
{{/if}}
{{#if (eq rubyWebFramework "grape")}}
gem "grape", "4.0.1"
{{/if}}
{{#if (eq rubyWebFramework "rails")}}
gem "railties", "8.1.4"
gem "actionpack", "8.1.4"
{{/if}}
{{#if (eq rubyOrm "active-record")}}
gem "activerecord", "8.1.4"
{{/if}}
{{#if (eq rubyOrm "sequel")}}
gem "sequel", "5.109.0"
{{/if}}
{{#if (eq rubyOrm "rom")}}
gem "rom", "5.4.3"
