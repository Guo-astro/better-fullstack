require "bundler/setup"
require "json"
require "net/http"
require "rbconfig"
require "securerandom"
require "socket"
require "tempfile"
require "timeout"

listener = TCPServer.new("127.0.0.1", 0)
port = listener.addr[1]
listener.close
log = Tempfile.new("{{rubyWebFramework}}-proof")
root = File.expand_path("..", __dir__)
environment = { "HOST" => "127.0.0.1", "PORT" => port.to_s, "RACK_ENV" => "production", "ALLOWED_ORIGIN" => "http://localhost:5173,http://localhost:8080", "SECRET_KEY_BASE" => SecureRandom.hex(64) }
{{#if (or (ne rubyOrm "none") (eq rubyAuth "rodauth"))}}
database = Tempfile.new(["proof", ".sqlite3"])
environment["DATABASE_PATH"] = database.path
{{/if}}
{{#if (eq rubyAuth "jwt")}}
environment["JWT_SECRET"] = SecureRandom.hex(32)
{{/if}}
{{#if (or (eq rubyAuth "rodauth") (eq rubyAuth "omniauth"))}}
environment["SESSION_SECRET"] = SecureRandom.hex(64)
{{/if}}
{{#if (eq rubyAuth "omniauth")}}
environment.merge!("OIDC_ISSUER" => "https://issuer.example.com", "OIDC_CLIENT_ID" => "proof-client", "OIDC_CLIENT_SECRET" => "proof-secret", "OIDC_REDIRECT_URI" => "http://127.0.0.1:#{port}/auth/oidc/callback")
{{/if}}
pid = nil

begin
{{#if (ne rubyOrm "none")}}
  migrated = system(environment, RbConfig.ruby, "-r", "./db", "-e", "BetterFullstack::Database.migrate!", chdir: root, out: log, err: log)
  raise "Database migration failed" unless migrated
{{/if}}
{{#if (eq rubyAuth "rodauth")}}
  migrated = system(environment, RbConfig.ruby, "-r", "./auth", "-e", "BetterFullstack::Auth.migrate!", chdir: root, out: log, err: log)
  raise "Account migration failed" unless migrated
{{/if}}
  pid = Process.spawn(
    environment,
    RbConfig.ruby, File.expand_path("server", __dir__),
    chdir: root, out: log, err: log, pgroup: true
  )
  http = Net::HTTP.new("127.0.0.1", port, nil)
  http.open_timeout = 1
  http.read_timeout = 2
  deadline = Process.clock_gettime(Process::CLOCK_MONOTONIC) + 20
  health = nil
  loop do
    raise "Server exited before readiness" if Process.waitpid(pid, Process::WNOHANG)
    begin
      health = http.get("/health")
      break if health.code == "200"
    rescue SystemCallError, IOError, Net::OpenTimeout, Net::ReadTimeout
    end
    raise "Server readiness timed out" if Process.clock_gettime(Process::CLOCK_MONOTONIC) >= deadline
    sleep 0.1
  end
  raise "Unexpected health response" unless JSON.parse(health.body) == { "status" => "ok", "service" => "{{rubyWebFramework}}" }
  ["http://localhost:5173", "http://localhost:8080"].each do |origin|
    response = http.get("/health", "Origin" => origin)
    raise "Frontend origin rejected" unless response.code == "200" && response["access-control-allow-origin"] == origin
    response = http.post("/api/greetings", JSON.generate(name: "Ruby"), "Content-Type" => "application/json", "Origin" => origin)
    raise "Frontend POST rejected" unless response.code == "200" && JSON.parse(response.body) == { "greeting" => "Hello, Ruby!" }
    response = http.post("/api/greetings", JSON.generate(name: "a" * 16_384), "Content-Type" => "application/json", "Origin" => origin)
    raise "Oversized response lost frontend access" unless response.code == "413" && response["access-control-allow-origin"] == origin && response["vary"] == "Origin" && JSON.parse(response.body).fetch("error") == "body_too_large"
  end
  response = http.get("/health", "Origin" => "http://localhost:9999")
  raise "Untrusted frontend accepted" unless response.code == "403"
  response = http.post("/api/greetings", JSON.generate(name: "Ruby"), "Content-Type" => "application/json")
  raise "Valid request failed" unless response.code == "200" && JSON.parse(response.body) == { "greeting" => "Hello, Ruby!" }
  response = http.post("/api/greetings", JSON.generate(name: " "), "Content-Type" => "application/json")
  raise "Invalid request was accepted" unless response.code == "422" && JSON.parse(response.body).fetch("error") == "name_length_must_be_1_to_80"
  response = http.post("/api/greetings", "", "Content-Type" => "application/json")
  raise "Empty JSON request was not rejected" unless response.code == "400" && JSON.parse(response.body).fetch("error") == "invalid_json"
{{#if (ne rubyOrm "none")}}
  response = http.post("/api/items", JSON.generate(name: "Ruby"), "Content-Type" => "application/json")
  raise "Item was not persisted" unless response.code == "201" && JSON.parse(response.body).fetch("name") == "Ruby"
  created = JSON.parse(response.body)
  response = http.get("/api/items")
  raise "Persisted item was not listed" unless response.code == "200" && JSON.parse(response.body).fetch("items").include?(created)
{{/if}}
{{#if (ne rubyAuth "none")}}
  response = http.get("/api/me")
  raise "Anonymous request was authenticated" unless response.code == "401"
{{/if}}
{{#if (eq rubyAuth "jwt")}}
  ENV["JWT_SECRET"] = environment["JWT_SECRET"]
  require_relative "../auth"
  response = http.get("/api/me", "Authorization" => "Bearer #{BetterFullstack::Auth.issue("proof-user")}")
  raise "Signed token was rejected" unless response.code == "200" && JSON.parse(response.body).dig("user", "id") == "proof-user"
  response = http.get("/api/me", "Authorization" => "Bearer #{BetterFullstack::Auth.issue("proof-user")}x")
  raise "Tampered token was accepted" unless response.code == "401"
{{/if}}
{{#if (eq rubyAuth "rodauth")}}
  response = http.post("/create-account", JSON.generate(login: "proof@example.com", password: "correct horse battery staple"), "Content-Type" => "application/json", "Accept" => "application/json")
  raise "Account creation failed" unless response.code == "200"
  cookie = response.get_fields("set-cookie").map { |value| value.split(";").first }.join("; ")
  response = http.get("/api/me", "Cookie" => cookie)
  raise "Session was not authenticated" unless response.code == "200" && JSON.parse(response.body).dig("user", "id")
  response = http.post("/login", JSON.generate(login: "proof@example.com", password: "wrong password"), "Content-Type" => "application/json", "Accept" => "application/json")
  raise "Wrong password was accepted" unless response.code == "401"
{{/if}}
{{#if (eq rubyAuth "omniauth")}}
  response = http.get("/auth/csrf")
  raise "CSRF token was not issued" unless response.code == "200" && !JSON.parse(response.body).fetch("csrf_token").empty?
  response = http.post("/auth/oidc", "")
  raise "Sign-in without a CSRF token was not rejected" unless response.code == "302" && response["location"].include?("/auth/failure")
{{/if}}
  puts JSON.generate(health: "passed", parsed_response: "passed", invalid_request: "passed", frontend_origins: "passed", empty_json: "passed"{{#if (ne rubyOrm "none")}}, persistence: "passed"{{/if}}{{#if (ne rubyAuth "none")}}, authentication: "passed"{{/if}})
rescue StandardError => error
  log.rewind
  warn log.read
  raise error
ensure
  if pid
    begin
      Process.kill("TERM", -pid)
      begin
        Timeout.timeout(10) { Process.wait(pid) }
      rescue Timeout::Error
        Process.kill("KILL", -pid)
        Process.wait(pid)
        raise "Server did not shut down after TERM"
      end
    rescue Errno::ESRCH, Errno::ECHILD
    end
  end
  log.close!
{{#if (or (ne rubyOrm "none") (eq rubyAuth "rodauth"))}}
  database.close!
{{/if}}
end
