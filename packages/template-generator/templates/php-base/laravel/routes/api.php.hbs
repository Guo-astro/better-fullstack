<?php

declare(strict_types=1);

use App\GreetingEndpoint;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Route;

Route::get('/health', fn () => response()->json(['status' => 'ok', 'framework' => 'laravel']));

Route::post('/api/greetings', function (Request $request) {
    [$status, $body] = GreetingEndpoint::respond((string) $request->header('Content-Type', ''), $request->getContent());
    return response()->json($body, $status);
});
