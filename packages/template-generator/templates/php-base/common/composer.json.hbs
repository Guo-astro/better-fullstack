{
  "name": "app/{{phpPackageName}}",
{{#if (eq phpWebFramework "laravel")}}
  "description": "Laravel JSON HTTP application generated by Better Fullstack",
{{else if (eq phpWebFramework "symfony")}}
  "description": "Symfony JSON HTTP application generated by Better Fullstack",
{{else}}
  "description": "Slim JSON HTTP application generated by Better Fullstack",
{{/if}}
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.5.12",
    "ext-json": "*",
{{#if (eq phpWebFramework "laravel")}}
    "ext-mbstring": "*",
    "ext-openssl": "*",
{{/if}}
{{#if (ne phpOrm "none")}}
    "ext-pdo_sqlite": "*",
{{/if}}
{{#if (eq phpOrm "cycle")}}
    "cycle/database": "~2.23.3",
    "cycle/orm": "~2.18.1",
{{/if}}
{{#if (eq phpOrm "doctrine")}}
{{#if (eq phpWebFramework "symfony")}}
    "doctrine/doctrine-bundle": "~3.3.3",
{{else}}
    "doctrine/dbal": "~4.5.0",
{{/if}}
    "doctrine/orm": "~3.7.5",
{{/if}}
{{#if (and (eq phpOrm "eloquent") (eq phpWebFramework "slim"))}}
    "illuminate/database": "~13.38.0",
{{/if}}
{{#if (eq phpWebFramework "laravel")}}
    "laravel/framework": "~13.38.0"
{{else if (eq phpWebFramework "symfony")}}
    "symfony/framework-bundle": "~8.1.9"
{{else}}
    "slim/slim": "~4.15.3",
    "slim/psr7": "~1.8.0"{{#if (eq phpOrm "doctrine")}},
    "symfony/cache": "~8.1.9"{{/if}}
{{/if}}
  },
  "require-dev": {
    "phpunit/phpunit": "~13.4.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "{{phpSourceDirectory}}/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php bin/serve.php"
    ],
    "build": [
      "@composer validate --strict",
      "@php bin/check.php",
      "@composer dump-autoload --optimize --strict-psr"
    ],
    "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php tests",
{{#if (ne phpOrm "none")}}
{{#if (eq phpWebFramework "laravel")}}
    "db:setup": "@php artisan migrate --force --no-interaction",
{{else}}
    "db:setup": "@php bin/db-setup.php",
{{/if}}
{{/if}}
    "proof:http": "@php bin/proof-http.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
