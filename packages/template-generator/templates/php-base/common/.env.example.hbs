{{#if (eq phpWebFramework "laravel")}}
APP_ENV=local
APP_KEY=
{{else if (eq phpWebFramework "symfony")}}
APP_ENV=prod
APP_DEBUG=0
{{/if}}
HOST=127.0.0.1
PORT=8080
CORS_ORIGIN=
{{#if (ne phpAuth "none")}}
JWT_SECRET=
JWT_ISSUER=better-fullstack
JWT_AUDIENCE=api
{{/if}}
{{#if (ne phpCache "none")}}
CACHE_NAMESPACE=app
{{/if}}
{{#if (eq phpCache "predis")}}
REDIS_URL=tcp://127.0.0.1:6379
{{/if}}
{{#if (eq phpJobQueue "laravel-queue")}}
CACHE_STORE=file
QUEUE_CONNECTION=database
{{/if}}
