{
  "name": "app/{{phpPackageName}}",
  "description": "Slim JSON HTTP application generated by Better Fullstack",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "~8.5.12",
    "ext-json": "*",
    "slim/slim": "~4.15.3",
    "slim/psr7": "~1.8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "~13.4.3"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "@php bin/serve.php"
    ],
    "build": [
      "@composer validate --strict",
      "@php bin/check.php",
      "@composer dump-autoload --optimize --strict-psr"
    ],
    "test": "@php vendor/bin/phpunit --bootstrap vendor/autoload.php tests",
    "proof:http": "@php bin/proof-http.php"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": false
  }
}
