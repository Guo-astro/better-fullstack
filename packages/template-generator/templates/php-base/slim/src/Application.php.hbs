<?php

declare(strict_types=1);

namespace App;

use InvalidArgumentException;
use JsonException;
use Psr\Http\Message\ResponseInterface;
use Psr\Http\Message\ServerRequestInterface;
use Psr\Http\Server\RequestHandlerInterface;
use Slim\App;
use Slim\Exception\HttpException;
use Slim\Factory\AppFactory;
use Throwable;

final class Application
{
{{#if (ne phpOrm "none")}}
    public static function create(string $corsOrigin = '', ?Notes $notes = null): App
{{else}}
    public static function create(string $corsOrigin = ''): App
{{/if}}
    {
        $app = AppFactory::create();
        $app->get('/health', function (ServerRequestInterface $request, ResponseInterface $response): ResponseInterface {
            return self::json($response, ['status' => 'ok', 'framework' => 'slim']);
        });
        $app->post('/api/greetings', function (ServerRequestInterface $request, ResponseInterface $response): ResponseInterface {
            $mediaType = strtolower(trim(explode(';', $request->getHeaderLine('Content-Type'))[0]));
            if ($mediaType !== 'application/json') {
                return self::json($response, ['error' => 'unsupported_media_type'], 415);
            }
            $stream = $request->getBody();
            if ($stream->isSeekable()) {
                $stream->rewind();
            }
            $body = '';
            while (strlen($body) < 4097 && !$stream->eof()) {
                $chunk = $stream->read(4097 - strlen($body));
                if ($chunk === '') {
                    break;
                }
                $body .= $chunk;
            }
            if (strlen($body) > 4096) {
                return self::json($response, ['error' => 'payload_too_large'], 413);
            }
            try {
                $greeting = Greeting::fromJson($body);
            } catch (JsonException) {
                return self::json($response, ['error' => 'invalid_json'], 400);
            } catch (InvalidArgumentException $error) {
                return self::json($response, ['error' => 'validation_failed', 'message' => $error->getMessage()], 422);
            }
            return self::json($response, ['message' => $greeting->message(), 'repetitions' => $greeting->repetitions]);
        });
{{#if (ne phpOrm "none")}}
        if ($notes !== null) {
            $app->get('/api/notes', function (ServerRequestInterface $request, ResponseInterface $response) use ($notes): ResponseInterface {
                return self::json($response, ['notes' => $notes->all()]);
            });
            $app->post('/api/notes', function (ServerRequestInterface $request, ResponseInterface $response) use ($notes): ResponseInterface {
                $body = (string) $request->getBody();
                if (strlen($body) > 4096) {
                    return self::json($response, ['error' => 'payload_too_large'], 413);
                }
                try {
                    $title = NoteInput::titleFromJson($body);
                } catch (JsonException) {
                    return self::json($response, ['error' => 'invalid_json'], 400);
                } catch (InvalidArgumentException $error) {
                    return self::json($response, ['error' => 'validation_failed', 'message' => $error->getMessage()], 422);
                }
                return self::json($response, $notes->add($title), 201);
            });
        }
{{/if}}
        $app->addRoutingMiddleware();
        $errors = $app->addErrorMiddleware(false, true, true);
        $errors->setDefaultErrorHandler(function (ServerRequestInterface $request, Throwable $error) use ($app): ResponseInterface {
            $status = $error instanceof HttpException ? $error->getCode() : 500;
            return self::json($app->getResponseFactory()->createResponse(), ['error' => $status === 404 ? 'not_found' : ($status === 405 ? 'method_not_allowed' : 'internal_error')], $status);
        });
        $corsOrigins = array_map('trim', explode(',', $corsOrigin));
        $app->add(function (ServerRequestInterface $request, RequestHandlerInterface $handler) use ($app, $corsOrigins): ResponseInterface {
            $response = $request->getMethod() === 'OPTIONS'
                ? $app->getResponseFactory()->createResponse(204)
                : $handler->handle($request);
            $origin = $request->getHeaderLine('Origin');
            if ($origin !== '' && in_array($origin, $corsOrigins, true)) {
                $response = $response->withHeader('Access-Control-Allow-Origin', $origin)
                    ->withHeader('Access-Control-Allow-Methods', 'GET, POST, OPTIONS')
                    ->withHeader('Access-Control-Allow-Headers', 'Content-Type')
                    ->withHeader('Vary', 'Origin');
            }
            return $response;
        });
        return $app;
    }

    private static function json(ResponseInterface $response, array $body, int $status = 200): ResponseInterface
    {
        $response->getBody()->write(json_encode($body, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES));
        return $response->withStatus($status)->withHeader('Content-Type', 'application/json');
    }
}
